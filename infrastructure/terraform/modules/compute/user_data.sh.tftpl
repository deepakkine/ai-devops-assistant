#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

echo "===== Installing minimum dependencies ====="

apt-get update -y

apt-get install -y \
    git \
    curl

APP_DIR="${app_dir}"
REPO_URL="${repo_url}"

echo "===== Cloning repository ====="

if [ ! -d "$APP_DIR/.git" ]; then
    rm -rf "$APP_DIR"
    git clone "$REPO_URL" "$APP_DIR"
fi

chown -R ubuntu:ubuntu "$APP_DIR"

chmod +x "$APP_DIR/deployment/bootstrap.sh"

echo "===== Running bootstrap script ====="

bash "$APP_DIR/deployment/bootstrap.sh"

echo "===== EC2 initialization completed ====="