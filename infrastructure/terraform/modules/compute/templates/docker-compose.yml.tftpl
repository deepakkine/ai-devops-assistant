services:
  backend:
    image: $${ECR_IMAGE}

    container_name: ai-devops-assistant

    restart: unless-stopped

    ports:
      - "127.0.0.1:8000:8000"

    env_file:
      - .env

    volumes:
      - chromadb_data:/app/storage/chromadb
      - huggingface_cache:/root/.cache/huggingface

    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

volumes:
  chromadb_data:
  huggingface_cache: